# Backend Service Environment Variables
# Copy this file to .env and update with your actual values

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_SECRET_KEY=generate-with-python-secrets-token-hex-32
JWT_SECRET_KEY=generate-with-python-secrets-token-hex-32
PORT=5000

# MongoDB Configuration
# Development (Docker): mongodb://admin:password123@mongo:27017/legal_ai?authSource=admin
# Production (Atlas): mongodb+srv://username:password@cluster.mongodb.net/legal_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://admin:password123@mongo:27017/legal_ai?authSource=admin
MONGO_DATABASE=legal_ai

# AI Service Configuration
# Development (Docker): http://ai-service:8000
# Production (Railway): https://your-ai-service.railway.app
AI_SERVICE_URL=http://ai-service:8000

# Email Configuration (Gmail Example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=Legal AI <your-email@gmail.com>
EMAIL_USE_TLS=true

# ServiceNow Integration (Optional - Production)
# SERVICENOW_INSTANCE=your-instance.service-now.com
# SERVICENOW_USERNAME=api-user
# SERVICENOW_PASSWORD=secure-password
# SERVICENOW_API_PATH=/api/now/table/incident

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# File Uploads
UPLOAD_FOLDER=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=DEBUG